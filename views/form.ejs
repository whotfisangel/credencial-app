<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link rel="stylesheet" href="/style.css">
  <meta charset="UTF-8" />
  <title>Generador de Credenciales</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<%- include('partials/nav') %>
  <div class="formulario">
    <h1>Generador de Credencial</h1>
    <form action="/generar" method="POST" enctype="multipart/form-data">

      <label for="nombre">Nombre:</label>
      <input type="text" name="nombre" required />

      <label for="matricula">Matrícula:</label>
      <input type="text" name="matricula" required />

      <label for="carrera">Carrera:</label>
      <select name="carrera" required>
        <% carreras.forEach(c => { %>
          <option value="<%= c.id %>"><%= c.nombre %></option>
        <% }) %>
      </select>

      <label for="foto">Foto:</label>
      <input type="file" name="foto" accept="image/*" capture="user" required />

      <button type="submit">Generar Credencial</button>
    </form>
  </div>
</body>

</html>
